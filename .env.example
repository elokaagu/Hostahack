NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback LLM when Grok is unavailable
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: comma-separated emails allowed to use the operator console
HOSTAHACK_OPERATOR_EMAILS=
