# xAI (Grok + live X search) — https://console.x.ai
XAI_API_KEY=
# Optional: override the model and reasoning effort
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low

# Supabase (tables are created by supabase/migrations/20261022220000_hostahack.sql)
